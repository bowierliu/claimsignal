  "info": {
    "description": "Read-only evidence lookups and checks over synthetic payer data and verified public sources. The service reports what the data shows. It never decides fraud, denial, coverage, or medical necessity; a human investigator decides.",
    "title": "ClaimSignal API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/claims/{claim_id}": {
      "get": {
        "description": "Return one claim as stored: header, lines with modifiers, diagnoses, and screen flags.",
        "operationId": "get_claim",
        "parameters": [
          {
            "description": "Claim id, for example C0000001.",
            "in": "path",
            "name": "claim_id",
            "required": true,
            "schema": {
              "description": "Claim id, for example C0000001.",
              "pattern": "^C[0-9]{7}$",
              "title": "Claim Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Well-formed id, but no such record."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A parameter was malformed."
          }
        },
        "summary": "Claim",
        "x-tool": true
      }
    },
    "/v1/claims/{claim_id}/checks/{check}": {
      "get": {
        "description": "Run one check on one claim: bundling, unit-limits, service-dates, duplicates, or codes.\n\nBundling and unit-limits use the synthetic rule tables, not real coding edits.",
        "operationId": "run_claim_check",
        "parameters": [
          {
            "description": "Claim id, for example C0000001.",
            "in": "path",
            "name": "claim_id",
            "required": true,
            "schema": {
              "description": "Claim id, for example C0000001.",
              "pattern": "^C[0-9]{7}$",
              "title": "Claim Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "check",
