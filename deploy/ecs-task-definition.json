{
  "family": "claims-copilot-api",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/EXECUTION_ROLE_NAME",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/TASK_ROLE_NAME",
  "volumes": [{ "name": "audit" }, { "name": "traces" }, { "name": "tmp" }],
  "containerDefinitions": [
    {
      "name": "api",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/claims-copilot-api:IMAGE_TAG",
      "essential": true,
      "user": "10001:10001",
      "readonlyRootFilesystem": true,
      "portMappings": [{ "containerPort": 8000, "protocol": "tcp" }],
      "secrets": [
        {
          "name": "CLAIMS_COPILOT_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:SECRET_NAME"
        }
      ],
      "mountPoints": [
        { "sourceVolume": "audit", "containerPath": "/app/data/audit" },
        { "sourceVolume": "traces", "containerPath": "/app/data/traces" },
        { "sourceVolume": "tmp", "containerPath": "/tmp" }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import sys,urllib.request as u; sys.exit(0 if u.urlopen('http://127.0.0.1:8000/v1/health', timeout=3).status == 200 else 1)\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/claims-copilot-api",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "api"
        }
      },
      "linuxParameters": { "capabilities": { "drop": ["ALL"] } }
    }
  ]
}
